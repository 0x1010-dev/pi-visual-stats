{
	"name": "pi-visual-stats",
	"version": "0.1.0",
	"description": "Pi extension: prompt-box bottom border as a context progress bar + compact footer",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "./preview.png"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit",
		"preview": "bun run scripts/preview.ts",
		"dev:link": "bash scripts/dev-link.sh"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"canvas": "^3.2.3",
		"typescript": "^5.5.0"
	}
}
